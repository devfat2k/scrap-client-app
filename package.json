{
  "name": "scrap-client-app",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "bunx expo prebuild --clean",
    "clean:metro": "expo start --clear",
    "clean:native": "rm -rf android ios .expo",
    "clean:deps": "rm -rf node_modules && bun install",
    "clean": "bun run clean:native && bun run clean:deps && bun run prebuild:clean",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "deps:check": "depcruise app --config .dependency-cruiser.js",
    "deps:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "check": "bun run compile && bun run lint:check && bun run deps:check && bun run test",
    "doctor": "bunx expo-doctor@latest",
    "align-deps": "bunx expo install --fix",
    "gen:icons": "svgr --native --typescript --icon --replace-attr-values \"#000=currentColor\" --out-dir app/components/icons/generated assets-src/svg",
    "gen:images": "bun scripts/optimize-images.ts",
    "gen": "bun run gen:icons && bun run gen:images",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.scrapclientapp .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "bunx eas-cli build --profile development --platform ios --local",
    "build:ios:device": "bunx eas-cli build --profile development:device --platform ios --local",
    "build:ios:preview": "bunx eas-cli build --profile preview --platform ios --local",
    "build:ios:prod": "bunx eas-cli build --profile production --platform ios --local",
    "build:android:sim": "bunx eas-cli build --profile development --platform android --local",
    "build:android:device": "bunx eas-cli build --profile development:device --platform android --local",
    "build:android:preview": "bunx eas-cli build --profile preview --platform android --local",
    "build:android:prod": "bunx eas-cli build --profile production --platform android --local"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "apisauce": "3.1.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.1",
    "react-native": "0.86.3",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@svgr/cli": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "sharp": "^0.35.5",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}